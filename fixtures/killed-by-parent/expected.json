{
  "description": "A worker process is terminated by its own parent (e.g. a timeout wrapper).",
  "command": ["sh", "-c", "sleep 30 & pid=$!; kill -TERM $pid; wait $pid"],
  "expect": { "status": "root_cause", "root_cause": "killed_by_traced_process", "minimum_confidence": "medium", "exit_code": 143, "required_evidence": ["SIGTERM"] }
}
